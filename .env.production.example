# === Exemple de configuration PRODUCTION (à copier en .env sur le serveur) ===
# Génère des secrets aléatoires : python -c "import secrets; print(secrets.token_urlsafe(48))"

APP_ENV=production
APP_DEBUG=false
BASE_URL=https://ton-domaine.com

# --- Secrets (OBLIGATOIRE de changer) ---
SECRET_KEY=CHANGE_ME_random_64_chars
JWT_SECRET=CHANGE_ME_autre_chaine_aleatoire

# --- Base de données (le mot de passe est aussi lu par le service db via DB_PASSWORD) ---
DB_PASSWORD=CHANGE_ME_mot_de_passe_db_fort
# DATABASE_URL / DATABASE_URL_SYNC sont surchargés par docker-compose (service 'db').

# --- Cookies : true une fois en HTTPS ---
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# --- Email (Gmail app-password ou Brevo) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ton@gmail.com
SMTP_PASSWORD=ton_app_password
SMTP_FROM_NAME=LIBFAD
SMTP_FROM_EMAIL=ton@gmail.com
SMTP_TLS=true

# --- Claude (assistant IA) ---
ANTHROPIC_API_KEY=

# --- Stripe (paiement des abonnements) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
