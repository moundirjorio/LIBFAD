# --- Application ---
APP_NAME=LIBFAD
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=change-me-to-a-random-64-char-string
BASE_URL=http://localhost:8000

# --- Database ---
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://libfad:libfad@localhost:5433/libfad
DATABASE_URL_SYNC=postgresql+psycopg2://libfad:libfad@localhost:5433/libfad

# --- Authentication ---
JWT_SECRET=change-me-too
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL_DEFAULT=claude-sonnet-4-6
CLAUDE_MODEL_HEAVY=claude-opus-4-7

# --- Bot Telegram ---
# Le jeton du bot se saisit dans l'interface (Automatisation → Bot Telegram), pas ici.
TELEGRAM_POLLING_ENABLED=true
TELEGRAM_AGENT_MODEL=claude-opus-5-5

# --- SMTP (emails sortants) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=app-password
SMTP_FROM_NAME=LIBFAD
SMTP_FROM_EMAIL=noreply@libfad.local
SMTP_TLS=true

# --- Locale / défauts ---
DEFAULT_LOCALE=fr_FR
DEFAULT_CURRENCY=EUR
DEFAULT_TIMEZONE=Europe/Paris

# --- Storage ---
STORAGE_DIR=./storage

# --- Scheduler (tâches quotidiennes automatiques : relances + abonnements) ---
SCHEDULER_ENABLED=true
SCHEDULER_HOUR=8
SCHEDULER_MINUTE=0
